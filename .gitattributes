# .gitattributes — LF normalization (matches .prettierrc endOfLine: lf)
#
# Goal: Windows working tree も LF にして prettier --check の false-positive を消す。
# Windows launcher (.bat/.vbs/.cmd/.ps1) は保守的に CRLF 維持 (native shell 互換性優先)。

# Auto-detect text vs binary; normalize text to LF
* text=auto eol=lf

# Binary — preserve as-is
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.ico binary
*.icns binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mov binary
*.mp3 binary
*.mp4 binary

# Web assets — force LF (SVG は XML、diff 可能)
*.svg text eol=lf
*.html text eol=lf
*.css text eol=lf

# JavaScript / config / docs — force LF (prettier endOfLine: lf と一致)
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.rs text eol=lf
*.plist text eol=lf

# Windows scripts — CRLF 維持 (保守的、native shell 互換性優先)
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf

# Version control config
.gitignore text eol=lf
.gitattributes text eol=lf
# Preserve upstream license whitespace in the generated notice document.
THIRD_PARTY_NOTICES.md whitespace=-blank-at-eol,-space-before-tab

# ---------------------------------------------------------------------------
# export-ignore — paid-release source.zip / public-mirror exclusions
#
# `git archive` (used by scripts/build-paid-release.mjs to build source.zip,
# and by any `git archive`-based export to the public mirror repo) omits any
# path marked `export-ignore` below. These are internal-only artifacts that
# must NOT reach buyers or the public repo: dated internal handoff/meeting
# notes, agent-workflow instructions (AGENTS.md / CLAUDE.md / the entire
# .claude/ harness of release-audit agents + skills), hidden-launcher
# scripts, and the
# operations/superpowers/decisions/legal-closure-ledger docs trees, plus the
# entire lp/ payment-infrastructure source (Astro LP + Cloudflare Pages
# Functions — server-side infra the operator runs, not part of the
# distributed Electron binary, so it is not GPL Corresponding Source for the
# installer). Keep this list in sync with scripts/build-paid-release.mjs's
# EXCLUDED_SOURCE_ENTRIES gate.
# ---------------------------------------------------------------------------
HANDOFF_2026-05-*.md export-ignore
GATE1_PRE_MEETING.md export-ignore
AGENTS.md export-ignore
CLAUDE.md export-ignore
.claude/ export-ignore
start.bat export-ignore
start-hidden.vbs export-ignore
docs/operations/ export-ignore
docs/superpowers/ export-ignore
docs/decisions/ export-ignore
docs/legal/REVIEW-NOTES.md export-ignore
# Free-phase exclusions (2026-10-03): while the product is distributed for
# free the sales-only disclosures (price / refund / 特商法) and the internal
# legal index that describes the paid flow stay out of the public mirror and
# source.zip. privacy-policy / recording-guidance / data-flow-matrix remain.
docs/legal/tokushoho.md export-ignore
docs/legal/terms-and-sales.md export-ignore
docs/legal/README.md export-ignore
# Tests that read export-ignored trees (lp/, docs/operations/, the sales legal
# docs) cannot pass in the exported tree, so they are exported with it.
tests/unit/paidBetaLpContract.test.js export-ignore
tests/unit/paidCloudflareConfig.test.js export-ignore
tests/unit/paidLegalContract.test.js export-ignore
tests/unit/paidReleaseBundle.test.js export-ignore
lp/ export-ignore
